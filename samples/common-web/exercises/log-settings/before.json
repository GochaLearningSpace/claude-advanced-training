{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/harness-hook.js"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(npm run *)", "Bash(git *)", "Edit(samples/common-web/**)"]
  }
}
